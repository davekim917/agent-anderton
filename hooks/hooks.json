{
  "description": "In a session holding an Anderton role, the repository's or a project's, wakes it when a session it answers for blocks on a person, or when the role's probe prints something new. Holds a message to an Anderton from its workers, or from a session in the repository that holds no role, that names no kind, and any message to an Anderton that repeats the last one sent; records a message once it is sent. Tells the command a host may set in ANDERTON_EVENT_COMMAND when a workgroup role's or its workers' turns start and end. No hook can approve anything.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/anderton/scripts/watch.sh\" --claude-start",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/anderton/scripts/watch.sh\" --claude-start",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/anderton/scripts/watch.sh\" --turn-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/anderton/scripts/watch.sh\"",
            "asyncRewake": true,
            "timeout": 1209600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/anderton/scripts/report-gate.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/anderton/scripts/report-gate.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
